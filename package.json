{
  "name": "ui-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Shared sci-fi HUD UI kit for the toolkit apps: Heptabase, IDEF0, SysML, Project, Pyramid, Profiler, Hypermail, Metropolis, Flow and BOM.",
  "type": "module",
  "exports": {
    "./css/*": "./css/*",
    "./adapters/*": "./adapters/*",
    "./fonts/*": "./fonts/*",
    "./theme": {
      "types": "./js/theme.d.ts",
      "default": "./js/theme.js"
    },
    "./theme-picker": {
      "types": "./js/theme-picker.d.ts",
      "default": "./js/theme-picker.js"
    },
    "./sync-status": {
      "types": "./js/sync-status.d.ts",
      "default": "./js/sync-status.js"
    },
    "./toast": {
      "types": "./js/toast.d.ts",
      "default": "./js/toast.js"
    },
    "./dialog": {
      "types": "./js/dialog.d.ts",
      "default": "./js/dialog.js"
    },
    "./command-palette": {
      "types": "./js/command-palette.d.ts",
      "default": "./js/command-palette.js"
    },
    "./portal-bar": {
      "types": "./js/portal-bar.d.ts",
      "default": "./js/portal-bar.js"
    },
    "./connections": {
      "types": "./js/connections.d.ts",
      "default": "./js/connections.js"
    },
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": ["css", "adapters", "fonts", "js", "tokens", "swift"],
  "scripts": {
    "test": "node --test test/",
    "tokens": "node scripts/build-tokens.mjs",
    "copy-into": "node scripts/copy-into.mjs",
    "check-copies": "node scripts/copy-into.mjs --check ../IDEF0/ui-kit ../SysML/ui-kit ../Project/ui-kit ../Flow/ui-kit ../skills/ui-kit",
    "serve": "python3 -m http.server 8130"
  }
}
