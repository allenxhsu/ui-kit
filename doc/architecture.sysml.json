      "ownerId": "pa_003",
      "doc": "Reads only the identity colour from tokens.json; serves /auth/me for the bar.",
      "isAbstract": false
    },
    "re_004": {
      "id": "re_004",
      "kind": "requirement",
      "name": "House rules",
      "ownerId": "pa_007",
      "doc": "",
      "reqId": "UI1",
      "text": "These describe the HUD skin. Under the macOS skin the platform’s conventions replace 1, 2 and 5; 3 and 4 always hold."
    },
    "re_005": {
      "id": "re_005",
      "kind": "requirement",
      "name": "Chamfers and brackets",
      "ownerId": "re_004",
      "doc": "",
      "reqId": "UI1.1",
      "text": "Pressable things are chamfered, and framing things get brackets. Don’t round corners."
    },
    "re_007": {
      "id": "re_007",
      "kind": "requirement",
      "name": "Orbitron for labels",
      "ownerId": "re_004",
      "doc": "",
      "reqId": "UI1.2",
      "text": "Orbitron is for labels, buttons and headings only. Anything read at length uses Exo 2."
    },
    "re_006": {
      "id": "re_006",
      "kind": "requirement",
      "name": "One glow per region",
      "ownerId": "re_004",
      "doc": "",
      "reqId": "UI1.3",
      "text": "The active item and the primary action glow; nothing else does."
    },
    "re_008": {
      "id": "re_008",
      "kind": "requirement",
      "name": "Status colours carry meaning",
      "ownerId": "re_004",
      "doc": "",
      "reqId": "UI1.4",
      "text": "Don’t use --sc-danger for decoration."
    },
    "re_009": {
      "id": "re_009",
      "kind": "requirement",
      "name": "Subtle effects",
      "ownerId": "re_004",
      "doc": "",
      "reqId": "UI1.5",
      "text": "Scanlines stay at their opacity, and everything decorative respects data-sc-effects=\"off\" and prefers-reduced-motion."
    },
    "re_001": {
      "id": "re_001",
      "kind": "requirement",
      "name": "Honest copies",
      "ownerId": "pa_007",
      "doc": "",
      "reqId": "UI2",
      "text": "A vendored copy shall match the kit it came from."
    },
    "re_003": {
      "id": "re_003",
      "kind": "requirement",
      "name": "Never edit a copy",
      "ownerId": "re_001",
      "doc": "",
      "reqId": "UI2.1",
      "text": "Change the kit here, then refresh from the app. This repo never writes into a sibling."
    },
    "re_002": {
      "id": "re_002",
      "kind": "requirement",
      "name": "A stale copy cannot ship",
      "ownerId": "re_001",
      "doc": "",
      "reqId": "UI2.2",
      "text": "An app’s build and serve scripts run --check and stop on drift."
    },
    "re_010": {
      "id": "re_010",
      "kind": "requirement",
      "name": "One source of truth",
      "ownerId": "pa_007",
      "doc": "",
      "reqId": "UI3",
      "text": "Every colour, font and spacing value shall come from tokens.json; CSS and Swift are generated from it."
    },
    "te_002": {
      "id": "te_002",
      "kind": "testCase",
      "name": "copy-into --check",
      "ownerId": "pa_012",
      "doc": "Compares a copy by content and lists every drifted file. npm run check-copies runs it over the sibling apps."
    },
    "te_003": {
      "id": "te_003",
      "kind": "testCase",
      "name": "Gallery review",
      "ownerId": "pa_012",
      "doc": "template/: every component in every palette and both skins, reviewed by eye. Not automated."
    },
    "te_001": {
      "id": "te_001",
      "kind": "testCase",
      "name": "build-tokens rerun",
      "ownerId": "pa_012",
      "doc": "Regenerating from tokens.json leaves tokens.css and SCTheme.swift unchanged."
    }
  },
