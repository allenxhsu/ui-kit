      "kind": "block",
      "name": "Toolkit app",
      "ownerId": "pa_003",
      "doc": "Heptabase, IDEF0, SysML, Project, Pyramid, Profiler, Hypermail, Metropolis, Flow, BOM.",
      "isAbstract": false
    },
    "bl_002": {
      "id": "bl_002",
      "kind": "block",
      "name": "Bundled app",
      "ownerId": "pa_003",
      "doc": "Heptabase, Hypermail — a Vite app. Depends on \"ui-kit\": \"file:../ui-kit\" and imports subpaths.",
      "isAbstract": false
    },
    "bl_003": {
      "id": "bl_003",
      "kind": "block",
      "name": "No-build app",
      "ownerId": "pa_003",
      "doc": "IDEF0, SysML, Project, Metropolis — serves its own folder, so keeps a verbatim copy at <app>/ui-kit/.",
      "isAbstract": false
    },
    "bl_004": {
      "id": "bl_004",
      "kind": "block",
      "name": "Single-file app",
      "ownerId": "pa_003",
